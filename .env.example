DATABASE_URL=mysql://openers:openers_password@127.0.0.1:3306/openers_dashboard
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_POOL_QUEUE_LIMIT=500
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=60000
# Use required when the production MySQL provider supports TLS.
DATABASE_TLS=disabled
TEST_DATABASE_URL=mysql://openers:openers_password@127.0.0.1:3306/openers_dashboard_test
ALLOW_INTEGRATION_TEST_DATABASE=false
DATABASE_ENVIRONMENT=development
DEPLOYMENT_ENVIRONMENT=development
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Enable only when the trusted reverse proxy overwrites X-Forwarded-* headers.
TRUSTED_PROXY_HEADERS=false
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_NAME=DialExpert
EMAIL_FROM_ADDRESS=no-reply@updates.dialexpert.com
EMAIL_REPLY_TO=
INVITATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TEMP_PASSWORD_ENCRYPTION_KEY=
# Separate base64 32-byte key used only for encrypted queued email payloads.
OUTBOX_ENCRYPTION_KEY=

# Long-running Node worker settings. Keep total DB demand within the pool limit.
IMPORT_WORKER_CONCURRENCY=2
IMPORT_WORKER_LEASE_SECONDS=120
IMPORT_WORKER_POLL_MS=2000
EMAIL_WORKER_CONCURRENCY=2
EMAIL_WORKER_LEASE_SECONDS=60
EMAIL_WORKER_POLL_MS=2000
EMAIL_PROVIDER_TIMEOUT_MS=10000

# Session and bounded retention defaults.
SESSION_ABSOLUTE_HOURS=168
ADMIN_SESSION_ABSOLUTE_HOURS=24
SESSION_IDLE_MINUTES=720
CLEANUP_BATCH_SIZE=500
RAW_CSV_RETENTION_DAYS=120
FAILED_IMPORT_RETENTION_DAYS=45
DRAFT_IMPORT_RETENTION_DAYS=14
AUTH_TOKEN_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=30

# Set by the release/deployment process. Neither value is secret.
APP_VERSION=0.1.0
GIT_COMMIT_SHA=

# Development demo seed only. Never set these in production or preview.
ALLOW_DESTRUCTIVE_DEMO_SEED=false
DEMO_SEED_PASSWORD=
# Required only when explicitly running the destructive local:reset-users script.
LOCAL_RESET_ADMIN_PASSWORD=

# Server-only Google Sheets transfer source
GOOGLE_TRANSFERS_APPS_SCRIPT_URL=
LEADERBOARD_API_SECRET=
GOOGLE_SHEETS_TIMEZONE=Africa/Cairo
NODE_ENV=development
